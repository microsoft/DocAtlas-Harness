from collections.abc import Sequence

class PdfiumError(RuntimeError): ...

class _PdfiumInfo:
    version: str

PYPDFIUM_INFO: _PdfiumInfo

class PdfBitmap:
    width: int
    height: int
    stride: int
    mode: str
    buffer: Sequence[int]
    def close(self) -> None: ...

class PdfTextPage:
    def get_text_range(self, index: int = ..., count: int = ..., errors: str = ...) -> str: ...
    def get_charbox(self, index: int, loose: bool = ...) -> tuple[float, float, float, float]: ...
    def close(self) -> None: ...

class PdfPage:
    def get_size(self) -> tuple[float, float]: ...
    def get_rotation(self) -> int: ...
    def get_textpage(self) -> PdfTextPage: ...
    def render(self, scale: float = ..., *, rev_byteorder: bool = ...) -> PdfBitmap: ...
    def close(self) -> None: ...

class PdfDocument:
    def __init__(self, source: str | bytes) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def close(self) -> None: ...
