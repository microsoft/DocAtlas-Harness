{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docatlas.dev/schemas/artifact-manifest.v1.json",
  "title": "DocAtlas Brief and Matrix artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactManifestId",
    "artifactId",
    "version",
    "workspaceId",
    "investigationId",
    "sourceScopeVersionId",
    "kind",
    "title",
    "status",
    "content",
    "contentHash",
    "personalizationUseIds",
    "createdBy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactManifestId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "artifactId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "version": { "type": "integer", "minimum": 1 },
    "previousArtifactManifestId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "workspaceId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "investigationId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "sourceScopeVersionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "kind": { "type": "string", "enum": ["brief", "matrix"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "status": { "type": "string", "enum": ["draft", "published", "superseded", "withdrawn"] },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/briefContent" },
        { "$ref": "#/$defs/matrixContent" }
      ]
    },
    "contentHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
    "personalizationUseIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" }
    },
    "publication": { "$ref": "#/$defs/publication" },
    "createdBy": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/actorRef" },
    "createdAt": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": { "properties": { "previousArtifactManifestId": false } },
      "else": {
        "properties": { "previousArtifactManifestId": {} },
        "required": ["previousArtifactManifestId"]
      }
    },
    {
      "if": { "properties": { "kind": { "const": "brief" } }, "required": ["kind"] },
      "then": { "properties": { "content": { "$ref": "#/$defs/briefContent" } } },
      "else": { "properties": { "content": { "$ref": "#/$defs/matrixContent" } } }
    },
    {
      "if": { "properties": { "status": { "const": "draft" } }, "required": ["status"] },
      "then": { "properties": { "publication": false } },
      "else": {
        "properties": { "publication": {} },
        "required": ["publication"]
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "unit"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "unit": { "const": "unicode-scalar" }
      }
    },
    "claimUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimUseId", "claimVersionId", "useKind", "span", "citationEvidenceIds"],
      "properties": {
        "claimUseId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "claimVersionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "useKind": {
          "type": "string",
          "enum": ["assertion", "assumption", "decision", "external-knowledge", "conflict-disclosure"]
        },
        "span": { "$ref": "#/$defs/span" },
        "citationEvidenceIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "useKind": { "enum": ["assertion", "conflict-disclosure"] } },
            "required": ["useKind"]
          },
          "then": { "properties": { "citationEvidenceIds": { "type": "array", "minItems": 1 } } },
          "else": { "properties": { "citationEvidenceIds": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "briefSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "heading", "markdown", "claimUses"],
      "properties": {
        "sectionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 50000, "pattern": "\\S" },
        "claimUses": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/claimUse" } }
      }
    },
    "briefContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sections"],
      "properties": {
        "kind": { "const": "brief" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/briefSection" }
        }
      }
    },
    "matrixSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "revisionId"],
      "properties": {
        "documentId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "revisionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" }
      }
    },
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowId", "label"],
      "properties": {
        "rowId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "source": { "$ref": "#/$defs/matrixSource" }
      }
    },
    "matrixColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columnId", "label"],
      "properties": {
        "columnId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "rowId", "columnId", "markdown", "claimUses"],
      "properties": {
        "cellId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "rowId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "columnId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "markdown": { "type": "string", "minLength": 1, "maxLength": 50000, "pattern": "\\S" },
        "claimUses": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/claimUse" } }
      }
    },
    "matrixContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rows", "columns", "cells"],
      "properties": {
        "kind": { "const": "matrix" },
        "rows": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/matrixRow" } },
        "columns": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/matrixColumn" } },
        "cells": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/matrixCell" } }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewResultId", "deterministicDecision", "publishedBy", "publishedAt"],
      "properties": {
        "reviewResultId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "deterministicDecision": { "type": "string", "enum": ["pass", "needs-human"] },
        "humanReviewDecisionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
        "publishedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actorId"],
          "properties": {
            "kind": { "type": "string", "enum": ["user", "system"] },
            "actorId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" }
          }
        },
        "publishedAt": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "deterministicDecision": { "const": "needs-human" } },
            "required": ["deterministicDecision"]
          },
          "then": {
            "properties": { "humanReviewDecisionId": {} },
            "required": ["humanReviewDecisionId"]
          },
          "else": { "properties": { "humanReviewDecisionId": false } }
        }
      ]
    }
  }
}
