{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docatlas.dev/schemas/source-representation.v1.json",
  "title": "DocAtlas source representation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "representationId",
    "documentId",
    "revisionId",
    "kind",
    "mediaType",
    "contentHash",
    "byteLength",
    "derivedFromRepresentationIds",
    "createdAt",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "representationId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "documentId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "revisionId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "kind": {
      "type": "string",
      "enum": [
        "original-bytes",
        "page-image",
        "embedded-text",
        "ocr-text",
        "derived-markdown",
        "table-extraction",
        "figure-crop",
        "model-description"
      ]
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "contentHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
    "byteLength": { "type": "integer", "minimum": 1 },
    "pageCount": { "type": "integer", "minimum": 1 },
    "textQuality": {
      "type": "string",
      "enum": ["empty", "sparse", "garbled", "usable", "not-applicable"]
    },
    "derivedFromRepresentationIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configHash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" }
      }
    },
    "createdAt": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/timestamp" },
    "status": {
      "type": "string",
      "enum": ["current", "stale", "failed", "deleted"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "not": { "const": "original-bytes" } } },
        "required": ["kind"]
      },
      "then": {
        "required": ["generator"],
        "properties": {
          "generator": {},
          "derivedFromRepresentationIds": { "type": "array", "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "derivedFromRepresentationIds": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["embedded-text", "ocr-text", "derived-markdown", "table-extraction", "model-description"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["textQuality"],
        "properties": { "textQuality": {} }
      }
    }
  ]
}
