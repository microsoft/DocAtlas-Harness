{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://docatlas.dev/schemas/enrichment.v1.json",
  "$defs": {
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scopeVersionId",
        "documentId",
        "revisionId",
        "sourceHash",
        "representationId",
        "representationHash",
        "navigationOnly",
        "offset",
        "total",
        "nextOffset",
        "kind",
        "jobs"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scopeVersionId": {
          "$ref": "#/$defs/id"
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "revisionId": {
          "$ref": "#/$defs/id"
        },
        "sourceHash": {
          "$ref": "#/$defs/hash"
        },
        "representationId": {
          "$ref": "#/$defs/id"
        },
        "representationHash": {
          "$ref": "#/$defs/hash"
        },
        "navigationOnly": {
          "const": true
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "enrichment-list"
        },
        "jobs": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jobId",
              "enrichmentId",
              "baseGenerationId",
              "baseTreeHash",
              "resultHash",
              "mode",
              "nodeCount"
            ],
            "properties": {
              "jobId": {
                "$ref": "#/$defs/id"
              },
              "enrichmentId": {
                "$ref": "#/$defs/id"
              },
              "baseGenerationId": {
                "$ref": "#/$defs/id"
              },
              "baseTreeHash": {
                "$ref": "#/$defs/hash"
              },
              "resultHash": {
                "$ref": "#/$defs/hash"
              },
              "mode": {
                "enum": [
                  "summary",
                  "expand",
                  "full"
                ]
              },
              "nodeCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "scopeVersionId",
        "documentId",
        "revisionId",
        "sourceHash",
        "representationId",
        "representationHash",
        "navigationOnly",
        "offset",
        "total",
        "nextOffset",
        "kind",
        "jobId",
        "enrichmentId",
        "baseGenerationId",
        "baseTreeHash",
        "resultHash",
        "inputHash",
        "recipe",
        "nodes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scopeVersionId": {
          "$ref": "#/$defs/id"
        },
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "revisionId": {
          "$ref": "#/$defs/id"
        },
        "sourceHash": {
          "$ref": "#/$defs/hash"
        },
        "representationId": {
          "$ref": "#/$defs/id"
        },
        "representationHash": {
          "$ref": "#/$defs/hash"
        },
        "navigationOnly": {
          "const": true
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "enrichment-page"
        },
        "jobId": {
          "$ref": "#/$defs/id"
        },
        "enrichmentId": {
          "$ref": "#/$defs/id"
        },
        "baseGenerationId": {
          "$ref": "#/$defs/id"
        },
        "baseTreeHash": {
          "$ref": "#/$defs/hash"
        },
        "resultHash": {
          "$ref": "#/$defs/hash"
        },
        "inputHash": {
          "$ref": "#/$defs/hash"
        },
        "recipe": {
          "enum": ["docatlas-flash-enrichment.v1", "docatlas-flash-enrichment.v2"]
        },
        "nodes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "tree": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "conversationId", "generation", "tree"], "properties": {
      "schemaVersion": {"const": 1}, "kind": {"const": "enrichment-tree"}, "conversationId": {"$ref": "#/$defs/id"},
      "generation": {"$ref": "https://docatlas.dev/schemas/tree-index.v1.json", "type": "object", "required": ["kind"], "properties": {"kind": {"const": "tree-generation"}}},
      "tree": {"$ref": "https://docatlas.dev/schemas/tree-index.v1.json", "type": "object", "required": ["kind"], "properties": {"kind": {"const": "tree-page"}}},
      "summaryPreviews": {"type": "array", "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["nodeId", "jobId", "resultHash", "preview", "summaryKind", "truncated"], "properties": {
        "nodeId": {"$ref": "#/$defs/id"}, "jobId": {"$ref": "#/$defs/id"}, "resultHash": {"$ref": "#/$defs/hash"},
        "preview": {"type": "string", "minLength": 1, "maxLength": 240}, "summaryKind": {"enum": ["model", "source-excerpt"]}, "truncated": {"type": "boolean"}
      }}}
    }},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "budget": {"type": "object", "additionalProperties": false, "required": ["maxNodes", "maxPages", "maxModelCalls", "maxInputChars", "maxOutputTokens", "maxOutputChars", "wallMs"], "properties": {
      "maxNodes": {"type": "integer", "minimum": 1, "maximum": 64}, "maxPages": {"type": "integer", "minimum": 1, "maximum": 50}, "maxModelCalls": {"type": "integer", "minimum": 1, "maximum": 64}, "maxInputChars": {"type": "integer", "minimum": 1000, "maximum": 300000}, "maxOutputTokens": {"type": "integer", "minimum": 128, "maximum": 32768}, "maxOutputChars": {"type": "integer", "minimum": 128, "maximum": 100000}, "wallMs": {"type": "integer", "minimum": 1000, "maximum": 300000}
    }},
    "request": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "idempotencyKey", "documentId", "revisionId", "baseMode", "nodeIds", "mode", "budget"], "properties": {
      "schemaVersion": {"const": 1}, "kind": {"const": "enrichment-start"}, "idempotencyKey": {"type": "string", "$ref": "#/$defs/id", "minLength": 16, "maxLength": 128}, "documentId": {"$ref": "#/$defs/id"}, "revisionId": {"$ref": "#/$defs/id"}, "baseMode": {"enum": ["raw", "merge"]}, "nodeIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "mode": {"enum": ["summary", "expand", "full"]}, "budget": {"$ref": "#/$defs/budget"}, "recipe": {"enum": ["docatlas-flash-enrichment.v1", "docatlas-flash-enrichment.v2"]}
    }},
    "node": {"type": "object", "additionalProperties": false, "required": ["nodeId", "parentId", "title", "startPage", "endPage", "sourceNodeId", "keyItems", "summary", "summaryKind"], "properties": {
      "nodeId": {"$ref": "#/$defs/id"}, "parentId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "startPage": {"type": "integer", "minimum": 1}, "endPage": {"type": "integer", "minimum": 1}, "sourceNodeId": {"type": ["string", "null"], "maxLength": 256}, "keyItems": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 500}}, "summary": {"type": ["string", "null"], "maxLength": 4000}, "summaryKind": {"enum": ["model", "source-excerpt", null]}
    }},
    "result": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "enrichmentId", "baseGenerationId", "baseTreeHash", "documentId", "revisionId", "sourceHash", "representationId", "representationHash", "recipe", "navigationOnly", "inputHash", "resultHash", "provider", "upstreamCommit", "nodes", "usage", "decisions"], "properties": {
      "schemaVersion": {"const": 1}, "kind": {"const": "tree-enrichment"}, "enrichmentId": {"$ref": "#/$defs/id"}, "baseGenerationId": {"$ref": "#/$defs/id"}, "baseTreeHash": {"$ref": "#/$defs/hash"}, "documentId": {"$ref": "#/$defs/id"}, "revisionId": {"$ref": "#/$defs/id"}, "sourceHash": {"$ref": "#/$defs/hash"}, "representationId": {"$ref": "#/$defs/id"}, "representationHash": {"$ref": "#/$defs/hash"}, "recipe": {"enum": ["docatlas-flash-enrichment.v1", "docatlas-flash-enrichment.v2"]}, "navigationOnly": {"const": true}, "inputHash": {"$ref": "#/$defs/hash"}, "resultHash": {"$ref": "#/$defs/hash"}, "upstreamCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
      "provider": {"type": "object", "additionalProperties": false, "required": ["provider", "model"], "properties": {"provider": {"type": "string", "minLength": 1, "maxLength": 128}, "model": {"type": "string", "minLength": 1, "maxLength": 256}}},
      "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}},
      "usage": {"type": "object", "additionalProperties": false, "required": ["calls", "inputChars", "outputTokens", "outputChars", "inputTokens"], "properties": {"calls": {"type": "integer", "minimum": 0}, "inputChars": {"type": "integer", "minimum": 0}, "outputTokens": {"type": "integer", "minimum": 0}, "outputChars": {"type": "integer", "minimum": 0}, "inputTokens": {"type": "integer", "minimum": 0}}},
      "decisions": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["nodeId", "decision", "costBefore", "costAfter"], "properties": {"nodeId": {"$ref": "#/$defs/id"}, "decision": {"enum": ["expanded", "kept-collapsed"]}, "costBefore": {"type": "integer", "minimum": 1}, "costAfter": {"type": "integer", "minimum": 1}}}}
    }},
    "job": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "jobId", "conversationId", "bindingId", "runtimeSessionId", "actorId", "workspaceId", "generation", "request", "state", "createdAt", "updatedAt", "result", "error"], "properties": {
      "schemaVersion": {"const": 1}, "kind": {"const": "enrichment-job"}, "jobId": {"$ref": "#/$defs/id"}, "conversationId": {"$ref": "#/$defs/id"}, "bindingId": {"$ref": "#/$defs/id"}, "runtimeSessionId": {"$ref": "#/$defs/id"}, "actorId": {"$ref": "#/$defs/id"}, "workspaceId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "request": {"$ref": "#/$defs/request"}, "state": {"enum": ["queued", "preparing", "generating", "completed", "failed", "cancelled"]}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "result": {"anyOf": [{"$ref": "#/$defs/result"}, {"type": "null"}]}, "error": {"enum": ["budget-exceeded", "invalid-output", "unavailable", "source-changed", null]}
    }}
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/job"}, {"$ref": "#/$defs/result"}, {"$ref": "#/$defs/tree"}, {"$ref": "#/$defs/list"}, {"$ref": "#/$defs/page"}]
}
