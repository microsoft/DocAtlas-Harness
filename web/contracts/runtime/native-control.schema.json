{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docatlas.dev/schemas/native-control.v1.json",
  "title": "DocAtlas native runtime controls and durable product operations v1",
  "oneOf": [
    { "$ref": "#/$defs/action" }, { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/apply" }, { "$ref": "#/$defs/outcome" },
    { "$ref": "#/$defs/command" }, { "$ref": "#/$defs/operation" }, { "$ref": "#/$defs/inspection" }
  ],
  "$defs": {
    "id": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
    "hash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "level": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "levels": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/level" } },
    "mode": { "enum": ["all", "one-at-a-time"] },
    "compactAction": {
      "type": "object", "additionalProperties": false, "required": ["kind", "instructions"],
      "properties": { "kind": { "const": "compact" }, "instructions": { "type": "string", "maxLength": 4096 } }
    },
    "head": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sessionId", "transcriptHash", "byteLength", "entryCount", "leafEntryId"],
      "properties": {
        "version": { "const": 1 }, "sessionId": { "$ref": "#/$defs/id" }, "transcriptHash": { "$ref": "#/$defs/hash" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }, "entryCount": { "$ref": "#/$defs/integer" },
        "leafEntryId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "thinkingLevel", "steeringMode", "followUpMode"],
      "properties": {
        "model": { "type": "object", "additionalProperties": false, "required": ["provider", "id"], "properties": { "provider": { "$ref": "#/$defs/name" }, "id": { "$ref": "#/$defs/name" } } },
        "thinkingLevel": { "$ref": "#/$defs/level" }, "steeringMode": { "$ref": "#/$defs/mode" }, "followUpMode": { "$ref": "#/$defs/mode" }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "id", "name", "thinkingLevels", "contextWindow", "maxTokens"],
      "properties": {
        "provider": { "$ref": "#/$defs/name" }, "id": { "$ref": "#/$defs/name" }, "name": { "$ref": "#/$defs/name" },
        "thinkingLevels": { "$ref": "#/$defs/levels" }, "contextWindow": { "$ref": "#/$defs/positive" }, "maxTokens": { "$ref": "#/$defs/positive" }
      }
    },
    "models": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/model" } },
    "action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "provider", "modelId"], "properties": { "kind": { "const": "set-model" }, "provider": { "$ref": "#/$defs/name" }, "modelId": { "$ref": "#/$defs/name" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "level"], "properties": { "kind": { "const": "set-thinking" }, "level": { "$ref": "#/$defs/level" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "queue", "mode"], "properties": { "kind": { "const": "set-queue-mode" }, "queue": { "enum": ["steering", "follow-up"] }, "mode": { "$ref": "#/$defs/mode" } } },
        { "$ref": "#/$defs/compactAction" }
      ]
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "configuration", "models", "thinkingLevels", "busy", "nativeQueue"],
      "properties": {
        "head": { "$ref": "#/$defs/head" }, "configuration": { "$ref": "#/$defs/configuration" }, "models": { "$ref": "#/$defs/models" },
        "thinkingLevels": { "$ref": "#/$defs/levels" }, "busy": { "type": "boolean" },
        "nativeQueue": { "type": "object", "additionalProperties": false, "required": ["steering", "followUp"], "properties": { "steering": { "$ref": "#/$defs/integer" }, "followUp": { "$ref": "#/$defs/integer" } } },
        "compaction": { "type": "object", "additionalProperties": false, "required": ["canCompact"], "properties": { "canCompact": { "type": "boolean" } } }
      }
    },
    "apply": {
      "type": "object", "additionalProperties": false, "required": ["operationId", "requestHash", "expectedHead", "action"],
      "properties": { "operationId": { "$ref": "#/$defs/id" }, "requestHash": { "$ref": "#/$defs/hash" }, "expectedHead": { "$ref": "#/$defs/head" }, "action": { "$ref": "#/$defs/action" } }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "requestHash", "action", "beforeHead", "afterHead", "intentEntryId", "markerEntryId", "configuration"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" }, "requestHash": { "$ref": "#/$defs/hash" }, "action": { "$ref": "#/$defs/action" },
        "beforeHead": { "$ref": "#/$defs/head" }, "afterHead": { "$ref": "#/$defs/head" },
        "intentEntryId": { "$ref": "#/$defs/id" }, "markerEntryId": { "$ref": "#/$defs/id" }, "configuration": { "$ref": "#/$defs/configuration" },
        "compaction": {
          "type": "object", "additionalProperties": false, "required": ["entryId", "firstKeptEntryId", "tokensBefore", "summaryHash"],
          "properties": { "entryId": { "$ref": "#/$defs/id" }, "firstKeptEntryId": { "$ref": "#/$defs/id" }, "tokensBefore": { "$ref": "#/$defs/integer" }, "summaryHash": { "$ref": "#/$defs/hash" } }
        }
      }
    },
    "failureProof": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "requestHash", "action", "beforeHead", "afterHead", "intentEntryId", "markerEntryId", "reason"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" }, "requestHash": { "$ref": "#/$defs/hash" }, "action": { "$ref": "#/$defs/compactAction" },
        "beforeHead": { "$ref": "#/$defs/head" }, "afterHead": { "$ref": "#/$defs/head" },
        "intentEntryId": { "$ref": "#/$defs/id" }, "markerEntryId": { "$ref": "#/$defs/id" }, "reason": { "enum": ["cancelled", "sdk-rejected"] }
      }
    },
    "outcome": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "proof"], "properties": { "status": { "enum": ["applied", "replayed"] }, "proof": { "$ref": "#/$defs/proof" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "failureProof"], "properties": { "status": { "const": "not-applied" }, "failureProof": { "$ref": "#/$defs/failureProof" } } }
      ]
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "conversationId", "expectedBindingId", "expectedGeneration", "runtimeSessionId", "approvalId", "expectedApprovalVersion", "expectedHead", "idempotencyKey", "action"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "native-command" }, "conversationId": { "$ref": "#/$defs/id" },
        "expectedBindingId": { "$ref": "#/$defs/id" }, "expectedGeneration": { "$ref": "#/$defs/positive" }, "runtimeSessionId": { "$ref": "#/$defs/id" },
        "approvalId": { "$ref": "#/$defs/id" }, "expectedApprovalVersion": { "$ref": "#/$defs/positive" }, "expectedHead": { "$ref": "#/$defs/head" },
        "idempotencyKey": { "type": "string", "$ref": "#/$defs/id", "minLength": 16 }, "action": { "$ref": "#/$defs/action" }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "operationId", "conversationId", "bindingId", "generation", "runtimeSessionId", "requestHash", "request", "state", "version", "createdAt", "updatedAt", "result", "errorCode"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "native-operation" }, "operationId": { "$ref": "#/$defs/id" }, "conversationId": { "$ref": "#/$defs/id" },
        "bindingId": { "$ref": "#/$defs/id" }, "generation": { "$ref": "#/$defs/positive" }, "runtimeSessionId": { "$ref": "#/$defs/id" },
        "requestHash": { "$ref": "#/$defs/hash" }, "request": { "$ref": "#/$defs/command" }, "state": { "enum": ["accepted", "applying", "succeeded", "failed", "outcome-unknown"] },
        "version": { "$ref": "#/$defs/positive" }, "createdAt": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/timestamp" },
        "updatedAt": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/timestamp" },
        "result": { "anyOf": [{ "$ref": "#/$defs/proof" }, { "type": "null" }] },
        "errorCode": { "enum": ["stale-state", "not-authorized", "invalid-action", "execution-interrupted", null] },
        "failureProof": { "$ref": "#/$defs/failureProof" }
      }
    },
    "inspection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "binding", "resource", "models", "state", "busy", "queued", "operations", "truncated"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "native-inspection" }, "binding": { "$ref": "https://docatlas.dev/schemas/product-control.v1.json#/$defs/binding" },
        "resource": { "type": "object", "additionalProperties": false, "required": ["approvalId", "version", "manifestHash"], "properties": { "approvalId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/positive" }, "manifestHash": { "$ref": "#/$defs/hash" } } },
        "models": { "$ref": "#/$defs/models" }, "state": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "busy": { "type": "boolean" }, "queued": { "$ref": "#/$defs/integer" },
        "operations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/operation" } }, "truncated": { "type": "boolean" }
      }
    }
  }
}
