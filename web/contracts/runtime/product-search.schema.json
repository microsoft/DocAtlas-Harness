{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docatlas.dev/schemas/product-search.v1.json",
  "title": "Explicit product tree search, separate from legacy sidecar v1",
  "oneOf": [ { "$ref": "#/$defs/request" }, { "$ref": "#/$defs/selection" }, { "$ref": "#/$defs/execution" } ],
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "recipe", "query", "strategy", "limits"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "product-search-request" },
        "recipe": { "const": "tree-search.v1" },
        "query": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "strategy": { "enum": ["fts", "tree", "combined"] },
        "limits": { "$ref": "https://docatlas.dev/schemas/sidecar-document-rpc.v1.json#/$defs/textLimits" },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "nodes"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "tree-search-selection" },
        "nodes": { "type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false, "required": ["key", "reason"],
          "properties": { "key": { "type": "string", "pattern": "^n[0-9]{1,5}$" }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } }
        } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "recipe", "requestHash", "strategies", "catalogTruncated", "nodesConsidered", "sourceCount", "model", "treeRefs"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "product-search-execution" },
        "recipe": { "const": "tree-search.v1" },
        "requestHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
        "strategies": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["fts", "tree"] } },
        "catalogTruncated": { "type": "boolean" },
        "nodesConsidered": { "type": "integer", "minimum": 0, "maximum": 2048 },
        "sourceCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "model": { "type": ["string", "null"], "maxLength": 1000 },
        "summaryRefs": { "type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false, "required": ["jobId", "resultHash", "baseGenerationId", "nodesUsed"],
          "properties": {
            "jobId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
            "resultHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
            "baseGenerationId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
            "nodesUsed": { "type": "integer", "minimum": 1, "maximum": 50 }
          }
        } },
        "treeRefs": { "type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["candidateId", "generationId", "treeHash", "sourceHash", "nodeId"],
          "properties": {
            "candidateId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
            "generationId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
            "nodeId": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/opaqueId" },
            "sourceHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" },
            "treeHash": { "$ref": "https://docatlas.dev/schemas/common.v1.json#/$defs/sha256" }
          }
        } }
      }
    }
  }
}
