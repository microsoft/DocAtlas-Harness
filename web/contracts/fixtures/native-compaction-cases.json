{
  "vectors": [
    { "name": "compact with empty optional guidance", "base": 0, "patches": [{ "path": [], "value": { "kind": "compact", "instructions": "" } }] },
    { "name": "compact preserves Unicode guidance", "base": 0, "patches": [{ "path": [], "value": { "kind": "compact", "instructions": "保留未完成的核验与文件路径。\n🔬 Do not turn old notes into evidence." } }] },
    { "name": "SDK preparation reports eligible", "base": 3, "patches": [{ "path": ["compaction"], "value": { "canCompact": true } }] },
    { "name": "exact compact apply", "base": 4, "patches": [{ "path": ["action"], "value": { "kind": "compact", "instructions": "" } }] },
    { "name": "successful compact has actual entry identity and summary hash only", "base": 5, "patches": [
      { "path": ["proof", "action"], "value": { "kind": "compact", "instructions": "" } },
      { "path": ["proof", "compaction"], "value": { "entryId": "entry:compact", "firstKeptEntryId": "entry:initial", "tokensBefore": 32768, "summaryHash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" } }
    ] },
    { "name": "frozen product compact command", "base": 6, "patches": [{ "path": ["action"], "value": { "kind": "compact", "instructions": "" } }] },
    { "name": "successful product compact receipt", "base": 7, "patches": [
      { "path": ["request", "action"], "value": { "kind": "compact", "instructions": "" } },
      { "path": ["result", "action"], "value": { "kind": "compact", "instructions": "" } },
      { "path": ["result", "compaction"], "value": { "entryId": "entry:compact", "firstKeptEntryId": "entry:initial", "tokensBefore": 32768, "summaryHash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" } }
    ] },
    { "name": "native proved non-application is not success", "base": 5, "patches": [
      { "path": ["status"], "value": "not-applied" }, { "path": ["proof"], "remove": true },
      { "path": ["failureProof"], "value": {
        "operationId": "native:operation-fixture", "requestHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "action": { "kind": "compact", "instructions": "" },
        "beforeHead": { "version": 1, "sessionId": "session:native-fixture", "transcriptHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "byteLength": 210, "entryCount": 2, "leafEntryId": "entry:initial" },
        "afterHead": { "version": 1, "sessionId": "session:native-fixture", "transcriptHash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "byteLength": 1900, "entryCount": 4, "leafEntryId": "entry:not-applied" },
        "intentEntryId": "entry:intent", "markerEntryId": "entry:not-applied", "reason": "cancelled"
      } }
    ] },
    { "name": "failed receipt keeps the original meaning of success result", "base": 7, "patches": [
      { "path": ["request", "action"], "value": { "kind": "compact", "instructions": "" } },
      { "path": ["state"], "value": "failed" }, { "path": ["result"], "value": null }, { "path": ["errorCode"], "value": "execution-interrupted" },
      { "path": ["failureProof"], "value": {
        "operationId": "native:operation-fixture", "requestHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "action": { "kind": "compact", "instructions": "" },
        "beforeHead": { "version": 1, "sessionId": "session:native-fixture", "transcriptHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "byteLength": 210, "entryCount": 2, "leafEntryId": "entry:initial" },
        "afterHead": { "version": 1, "sessionId": "session:native-fixture", "transcriptHash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "byteLength": 1900, "entryCount": 4, "leafEntryId": "entry:not-applied" },
        "intentEntryId": "entry:intent", "markerEntryId": "entry:not-applied", "reason": "sdk-rejected"
      } }
    ] },
    { "name": "new inspection advertises unavailable compaction without changing old settings", "base": 8, "patches": [{ "path": ["state", "compaction"], "value": { "canCompact": false } }] }
  ],
  "invalidShape": [
