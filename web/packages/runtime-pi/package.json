{
  "name": "@docatlas/runtime-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./testing": { "types": "./lib/testing.d.ts", "default": "./lib/testing.js" },
    "./worker": { "types": "./lib/worker/index.d.ts", "default": "./lib/worker/index.js" },
    "./worker/entry": { "default": "./lib/worker/entry.js" }
  },
  "files": ["lib"],
  "scripts": {
    "prebuild": "pnpm --filter @docatlas/core build",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docatlas/core": "workspace:*",
    "typebox": "1.3.7",
    "@docatlas/contracts": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
