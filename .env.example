# ── Azure OpenAI / Responses API ────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Your Azure deployment (model) name, e.g. gpt-4o. Required — no default.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: API key auth. If unset, AzureCliCredential is used (requires `az login`).
# AZURE_OPENAI_API_KEY=
# HARNESS_ENV_FILE=/absolute/path/to/.env  # for installed CLI use outside this checkout

# ── Aux LLM (used by search and review) ─────────────────────────────
# Defaults to the AZURE_OPENAI_* values above when unset.
# HARNESS_AUX_LLM_ENDPOINT=
# HARNESS_AUX_LLM_API_VERSION=
# HARNESS_AUX_LLM_MODEL=
# HARNESS_AUX_LLM_API_KEY=

# ── Scoring (docatlas/scoring/*.py) ─────────────────────────────────
# Scorers read credentials from the environment (no default model/endpoint).
# For OpenAI-compatible endpoints, set OPENAI_API_KEY (+ optional OPENAI_BASE_URL);
# for Azure models they reuse AZURE_OPENAI_* above. Pass --model on the CLI.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── Skill subprocess interpreter ────────────────────────────────────
# Defaults to the uv-managed interpreter running the harness. Override only
# when a custom Skill has an isolated, compatible environment.
# HARNESS_SKILL_PYTHON=.venv/bin/python

# ── Local state and input safety limits ─────────────────────────────
# HARNESS_SESSIONS_ROOT=outputs/sessions
# HARNESS_MAX_PAGES_PER_READ=50
# HARNESS_MAX_FIGURE_BYTES=20971520
# HARNESS_MAX_MARKDOWN_BYTES=5242880
# HARNESS_MAX_TEXT_CHARS_PER_PAGE=200000
# HARNESS_MAX_TREE_PROMPT_CHARS=500000
# HARNESS_MAX_PAGE_IMAGE_PIXELS=25000000
# HARNESS_MAX_PAGE_IMAGE_BYTES=20971520
# HARNESS_LLM_TIMEOUT_SECONDS=120
# HARNESS_AUX_LLM_TIMEOUT_SECONDS=120
