# ── Azure OpenAI / Responses API ────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Your Azure deployment (model) name, e.g. gpt-4o. Required — no default.
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: API key auth. If unset, AzureCliCredential is used (requires `az login`).
# AZURE_OPENAI_API_KEY=

# ── Aux LLM (used by Search and Review skills) ──────────────────────
# Defaults to the AZURE_OPENAI_* values above when unset.
# HARNESS_AUX_LLM_ENDPOINT=
# HARNESS_AUX_LLM_API_VERSION=
# HARNESS_AUX_LLM_MODEL=
# HARNESS_AUX_LLM_API_KEY=

# ── Scoring (scoring/*.py) ──────────────────────────────────────────
# Scorers read credentials from the environment (no default model/endpoint).
# For OpenAI-compatible endpoints, set OPENAI_API_KEY (+ optional OPENAI_BASE_URL);
# for Azure models they reuse AZURE_OPENAI_* above. Pass --model on the CLI.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# ── Python interpreter for skill subprocesses ───────────────────────
# Defaults to the harness's own Python (the one running `python -m harness ...`).
# Override if your skill scripts need a different venv. After `uv sync`,
# the canonical value is the local .venv/bin/python:
# HARNESS_SKILL_PYTHON=.venv/bin/python
# HARNESS_DRIVER_PYTHON=.venv/bin/python
